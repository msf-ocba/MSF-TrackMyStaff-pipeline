# ============================================================
# Secrets / config
# ============================================================
# Holds SFTP + SMTP credentials in plain text - never commit this.
config.conf

# In case anyone copies it under a different name while testing
*.conf.local
*.env

# ============================================================
# Pipeline data & working folders (all runtime-generated)
# ============================================================
downloads/
work/
output/
logs/

# Lock file used by run_pipeline.py
.pipeline.lock

# ============================================================
# Templates synced by hand from SharePoint/TMS
# (org data, not code - re-synced locally, not versioned)
# ============================================================
templates/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# ============================================================
# Excel lock files (left behind if a workbook was open when
# something crashed, or opened directly from the repo folder)
# ============================================================
~$*.xlsx
~$*.xls
*.xlsx.lock

# ============================================================
# OS / editor cruft
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
